{
    "name": "secret-terminal",
    "version": "0.1.7",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "repository": "https://github.com/solvospace/secret-terminal.git",
    "scripts": {
        "dev": "concurrently \"turbo run dev --concurrency=20\" \"wait-on http://app.localhost:3000 && open http://app.localhost:3000\"",
        "clean": "turbo run clean",
        "clean:all": "bash ./scripts/clean.sh",
        "build": "turbo build --concurrency=4",
        "start": "turbo start",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "check": "oxfmt --check && oxlint --deny-warnings",
        "check:fix": "oxlint --fix && oxfmt",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "dependencies": {
        "@secret-terminal/config": "workspace:*",
        "@secret-terminal/services": "workspace:*",
        "@secret-terminal/types": "workspace:*"
    },
    "devDependencies": {
        "@commitlint/cli": "catalog:",
        "@commitlint/config-conventional": "catalog:",
        "@commitlint/types": "catalog:",
        "@types/node": "catalog:",
        "concurrently": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "wait-on": "catalog:"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
            "oxlint --fix --deny-warnings",
            "oxfmt"
        ],
        "*.{json,jsonc,css,md}": [
            "oxfmt"
        ]
    },
    "engines": {
        "node": ">=24.22.3"
    },
    "packageManager": "pnpm@12.18.0"
}
