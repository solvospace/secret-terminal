{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 122,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "singleAttributePerLine": true,
    "ignorePatterns": [],
    "sortImports": {
        "newlinesBetween": false,
        "order": "asc",
        "ignoreCase": true,
        "groups": ["value-builtin", "value-default-import", "value-named-import", "type-import", "unknown"]
    }
}
