{
    "name": "backend-v2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nest build",
        "deploy": "nest deploy",
        "dev": "nest start --watch",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "test": "vitest run",
