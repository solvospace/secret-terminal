{
    "name": "backend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --debug=9230 --watch",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug=9230 --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
        "db:migrate:dev": "bash ./scripts/migrate-dev.sh",
        "db:migrate:prod": "bash ./scripts/migrate-prod.sh"
    },
