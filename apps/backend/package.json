{
    "name": "backend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm run prisma:generate && nest build",
        "dev": "nest start --watch",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug 9230 --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
        "prisma:generate": "tsx scripts/prisma-generate.ts",
        "prisma:migrate": "tsx scripts/prisma-migrate.ts"
    },
    "dependencies": {
        "@fastify/cookie": "catalog:",
        "@fastify/formbody": "catalog:",
        "@fastify/helmet": "catalog:",
        "@fastify/multipart": "catalog:",
        "@nestjs/common": "catalog:",
        "@nestjs/config": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/platform-fastify": "catalog:",
        "@prisma/adapter-pg": "catalog:",
        "@prisma/client": "catalog:",
        "@types/bcrypt": "catalog:",
        "@types/jsonwebtoken": "catalog:",
        "@types/ms": "catalog:",
        "ai": "catalog:",
        "axios": "catalog:",
        "bcrypt": "catalog:",
        "class-transformer": "catalog:",
        "class-validator": "catalog:",
        "fastify": "catalog:",
        "hcaptcha": "catalog:",
        "jsonwebtoken": "catalog:",
        "reflect-metadata": "catalog:",
        "resend": "catalog:",
        "rxjs": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@nestjs/cli": "catalog:",
        "@nestjs/mau": "catalog:",
        "@nestjs/schematics": "catalog:",
        "@nestjs/testing": "catalog:",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "@types/supertest": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "prettier": "catalog:",
        "prisma": "catalog:",
        "source-map-support": "catalog:",
