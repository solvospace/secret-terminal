model User {
    id        String   @id @unique @default(dbgenerated("uuidv7()")) @db.Uuid
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt() @map("updated_at") @db.Timestamp(6)

    watchlists    Watchlist[]
    refreshTokens RefreshToken[]
    resetCodes    ResetCode[]

    verified                  Boolean  @default(false)
    verificationCode          String?  @unique
    verificationCodeExpiresAt DateTime @default(dbgenerated("(now() + '00:10:00'::interval)")) @map("verification_code_expires_at") @db.Timestamp(6)

    @@map("users")
    @@schema("auth")
}

model RefreshToken {
    id        String   @id @unique @default(dbgenerated("uuidv7()")) @db.Uuid
    token     String   @unique
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    userId String @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("refresh_tokens")
    @@schema("auth")
}

model ResetCode {
    id        String   @id @unique @default(dbgenerated("uuidv7()")) @db.Uuid
    code      String   @unique
    verified  Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    expiresAt DateTime @default(dbgenerated("(now() + '00:15:00'::interval)")) @map("expires_at") @db.Timestamp(6)

    userId String @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("reset_codes")
    @@schema("auth")
}
